# Veritabanı bağlantısı. Geliştirmede dosya tabanlı SQLite kullanılır.
# Üretimde PostgreSQL için: postgresql+psycopg://kullanici:sifre@host:5432/awe
AWE_DATABASE_URL=sqlite:///./awe_dev.db

# Uygulama log seviyesi.
AWE_LOG_LEVEL=INFO

# Proje bazlı adapter/threshold konfigürasyonlarının okunduğu dizin.
AWE_PROJECT_CONFIG_DIR=./config_examples
