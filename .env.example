# Veritabanı bağlantısı. Geliştirmede dosya tabanlı SQLite kullanılır.
# Üretimde PostgreSQL için: postgresql+psycopg://kullanici:sifre@host:5432/awe
AWE_DATABASE_URL=sqlite:///./awe_dev.db

# Uygulama log seviyesi.
AWE_LOG_LEVEL=INFO

# Proje bazlı adapter/threshold konfigürasyonlarının okunduğu dizin.
AWE_PROJECT_CONFIG_DIR=./config_examples

# CompanyHelper backend'inden tek seferlik event export'u çekmek için
# (scripts/fetch_companyhelper_export.py). Bu dosyaya (.env) GERÇEK değerleri yaz --
# .env zaten git'e girmez, .env.example yalnızca şekli gösterir.
COMPANYHELPER_BASE_URL=http://your-companyhelper-host:3000
COMPANYHELPER_EMAIL=
COMPANYHELPER_PASSWORD=
